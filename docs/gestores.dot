digraph UML { graph [rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.6, fontname="Helvetica", fontsize=13, pad=0.2, dpi=200, newrank=true]; node [shape=plain, fontname="Helvetica", fontsize=10.5]; edge [fontname="Helvetica", fontsize=9.5, color="#444444"];
GestorParticipantes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><B>GestorParticipantes</B><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ DIAS_INACTIVIDAD: int = 30  {static}<BR/>- huerto: Huerto</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ registrar(cedula, nombres, ..., rol, fechaIngreso, hoy)  «RF-01»<BR/>+ buscar(texto): List&lt;Participante&gt;  «RF-02»<BR/>+ actualizar(cedula, nombres, apellidos, telefono, rol)  «RF-02»<BR/>+ cambiarEstado(cedula, estado)  «RF-02»<BR/>+ eliminar(cedula)  «RF-02»<BR/>+ calcularParticipacion(desde, hasta, hoy): List  «RF-03»<BR/>+ aplicarReglaInactividad(hoy): int  «RF-03»</TD></TR></TABLE>>];
GestorCultivos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><B>GestorCultivos</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- huerto: Huerto</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ registrarParcela(codigo, area, ubicacion, riego): Parcela  «RF-04»<BR/>+ actualizarParcela(...) / eliminarParcela(codigo)  «RF-04»<BR/>+ registrarSiembra(parcela, tipo, variedad, fecha, area, hoy)  «RF-05»<BR/>+ cambiarEstado(cultivo, nuevo, causa, hoy): String  «RF-06»<BR/>+ getPropuestasListoParaCosecha(hoy): List&lt;Cultivo&gt;  «RF-06»<BR/>+ cancelarLaboresAbiertas(cultivo): int</TD></TR></TABLE>>];
GestorLabores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#ffe0b2" ALIGN="CENTER"><B>GestorLabores</B><BR/><FONT POINT-SIZE="8">M3</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ HORAS_MINIMAS: double = 0.5  {static}<BR/>+ HORAS_MAXIMAS: double = 8  {static}<BR/>+ FRECUENCIA_MAXIMA: int = 30  {static}<BR/>- huerto: Huerto</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ programar(tipo, cultivo, responsable, fecha, frecuencia, hoy)  «RF-07»<BR/>+ reprogramar(labor, fecha, responsable, hoy) / cancelar(labor)  «RF-07»<BR/>+ registrarCumplimiento(labor, fecha, horas, obs, hoy)  «RF-08»<BR/>+ actualizarAtrasadas(hoy): int  «RF-09»<BR/>+ generarAgenda(dia, hoy, responsable, cultivo)  «RF-09»</TD></TR></TABLE>>];
GestorCosechas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e1bee7" ALIGN="CENTER"><B>GestorCosechas</B><BR/><FONT POINT-SIZE="8">M4</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- huerto: Huerto<BR/>- gestorCultivos: GestorCultivos</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ registrarCosecha(cultivo, fecha, kg, hoy): Cosecha  «RF-10»<BR/>+ calcularReparto(cosecha, porcentajeReserva): Reparto  «RF-11»<BR/>+ guardarReparto(cosecha, reparto)  «RF-11»<BR/>+ generarReporte(desde, hasta): ReporteProduccion  «RF-12»</TD></TR></TABLE>>];
ValidadorCedula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><B>ValidadorCedula</B><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ esValida(cedula): boolean  {static}</TD></TR></TABLE>>];
ResumenParticipacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><B>ResumenParticipacion</B><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- numeroLabores: int<BR/>- horas: double<BR/>- porcentaje: double</TD></TR></TABLE>>];
AgendaSemanal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#ffe0b2" ALIGN="CENTER"><B>AgendaSemanal</B><BR/><FONT POINT-SIZE="8">M3</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- lunes, domingo: LocalDate<BR/>- labores: List&lt;Labor&gt;<BR/>- atrasadasPorResponsable: Map<BR/>- atrasadasPorCultivo: Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ agregar(labor)<BR/>+ getTotalAtrasadas(): int</TD></TR></TABLE>>];
ReporteProduccion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e1bee7" ALIGN="CENTER"><B>ReporteProduccion</B><BR/><FONT POINT-SIZE="8">M4</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- desde, hasta: LocalDate<BR/>- filas: List&lt;FilaProduccion&gt;<BR/>- cultivosCosechados, cultivosPerdidos: int<BR/>- horasTrabajadas: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ getKgTotales(): double<BR/>+ getPorcentajePerdidos(): double</TD></TR></TABLE>>];
FilaProduccion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e1bee7" ALIGN="CENTER"><B>FilaProduccion</B><BR/><FONT POINT-SIZE="8">M4</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- cultivo: String<BR/>- cosechas: int<BR/>- kg, area, kgEsperados: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ getKgPorM2(): double<BR/>+ getRendimiento(): double</TD></TR></TABLE>>];
ReglaNegocioException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e0e0e0" ALIGN="CENTER"><B>ReglaNegocioException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ ReglaNegocioException(mensaje)</TD></TR></TABLE>>];
Huerto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#777777" BGCOLOR="#e0e0e0"><TR><TD><B>Huerto  (figura 1)</B></TD></TR></TABLE>>];
{rank=same; GestorParticipantes; GestorCultivos;}
{rank=same; ValidadorCedula; ResumenParticipacion; ReglaNegocioException;}
{rank=same; GestorLabores; GestorCosechas;}
{rank=same; AgendaSemanal; ReporteProduccion;}
GestorParticipantes -> GestorCultivos [style=invis];
ValidadorCedula -> ResumenParticipacion -> ReglaNegocioException [style=invis];
GestorLabores -> GestorCosechas [style=invis];
AgendaSemanal -> ReporteProduccion [style=invis];
Huerto -> GestorParticipantes [dir=back, arrowtail=vee, taillabel="1"];
Huerto -> GestorCultivos [dir=back, arrowtail=vee, taillabel="1"];
ValidadorCedula -> GestorLabores [style=invis]; ReglaNegocioException -> GestorCosechas [style=invis];
GestorLabores -> Huerto [arrowhead=vee, headlabel="1", constraint=false];
GestorCosechas -> Huerto [arrowhead=vee, headlabel="1", constraint=false];
GestorCosechas -> GestorCultivos [arrowhead=vee, headlabel="1", constraint=false];
GestorParticipantes -> ValidadorCedula [style=dashed, arrowhead=vee, xlabel="usa"];
GestorParticipantes -> ResumenParticipacion [style=dashed, arrowhead=vee, xlabel="crea"];
GestorLabores -> AgendaSemanal [style=dashed, arrowhead=vee, xlabel="crea"];
GestorCosechas -> ReporteProduccion [style=dashed, arrowhead=vee, xlabel="crea"];
ReporteProduccion -> FilaProduccion [dir=back, arrowtail=diamond, taillabel="1", headlabel="0..*"];
GestorCultivos -> ReglaNegocioException [style=dashed, arrowhead=vee, xlabel="lanza"];
}