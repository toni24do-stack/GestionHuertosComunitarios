digraph UML { graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.25, fontname="Helvetica", fontsize=13, pad=0.2, dpi=200, newrank=true]; node [shape=plain, fontname="Helvetica", fontsize=10.5]; edge [fontname="Helvetica", fontsize=9.5, color="#444444"];
RolHuerto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>RolHuerto</B><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">PARTICIPANTE, COORDINADOR</TD></TR></TABLE>>];
EstadoParticipante [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoParticipante</B><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">ACTIVO, INACTIVO</TD></TR></TABLE>>];
TipoRiego [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoRiego</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">MANUAL, GOTEO</TD></TR></TABLE>>];
EstadoCultivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoCultivo</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">SEMBRADO, EN_CRECIMIENTO,<BR/>LISTO_PARA_COSECHA,<BR/>COSECHADO, PERDIDO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ esActivo(): boolean<BR/>+ puedeCambiarA(nuevo): boolean</TD></TR></TABLE>>];
CausaPerdida [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>CausaPerdida</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">PLAGA, FALTA_DE_RIEGO,<BR/>CLIMA, OTRA</TD></TR></TABLE>>];
TipoLabor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#ffe0b2" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoLabor</B><BR/><FONT POINT-SIZE="8">M3</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">RIEGO, DESHIERBE, ABONADO,<BR/>CONTROL_DE_PLAGAS, PODA</TD></TR></TABLE>>];
EstadoLabor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#ffe0b2" ALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoLabor</B><BR/><FONT POINT-SIZE="8">M3</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">PENDIENTE, ATRASADA,<BR/>COMPLETADA, CANCELADA</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ estaAbierta(): boolean</TD></TR></TABLE>>];
{rank=same; RolHuerto; EstadoParticipante; TipoRiego;}
{rank=same; CausaPerdida; EstadoCultivo;}
{rank=same; TipoLabor; EstadoLabor;}
RolHuerto -> CausaPerdida -> TipoLabor [style=invis]; EstadoParticipante -> EstadoCultivo -> EstadoLabor [style=invis];
}