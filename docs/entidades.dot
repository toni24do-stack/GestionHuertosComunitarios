digraph UML { graph [rankdir=TB, splines=ortho, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=13, pad=0.2, dpi=200, newrank=true]; node [shape=plain, fontname="Helvetica", fontsize=10.5]; edge [fontname="Helvetica", fontsize=9.5, color="#444444"];
Huerto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e0e0e0" ALIGN="CENTER"><B>Huerto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- nombre: String<BR/>- participantes: List&lt;Participante&gt;<BR/>- parcelas: List&lt;Parcela&gt;<BR/>- catalogo: List&lt;TipoCultivo&gt;<BR/>- labores: List&lt;Labor&gt;<BR/>- cosechas: List&lt;Cosecha&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ getCultivos(): List&lt;Cultivo&gt;<BR/>+ buscarTipoCultivo(nombre): TipoCultivo<BR/>+ generarIdCultivo(): String<BR/>+ generarNumeroLabor(): int<BR/>+ generarCodigoCosecha(): String</TD></TR></TABLE>>];
Persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Persona</B></I><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- cedula: String<BR/>- nombres: String<BR/>- apellidos: String<BR/>- telefono: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ getNombreCompleto(): String<BR/>+ getDescripcion(): String  {abstract}</TD></TR></TABLE>>];
Participante [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#c8e6c9" ALIGN="CENTER"><B>Participante</B><BR/><FONT POINT-SIZE="8">M1</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- rol: RolHuerto<BR/>- estado: EstadoParticipante<BR/>- fechaIngreso: LocalDate<BR/>- horasAcumuladas: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ estaActivo(): boolean<BR/>+ sumarHoras(horas: double)<BR/>+ getDescripcion(): String</TD></TR></TABLE>>];
Parcela [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><B>Parcela</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- codigo: String<BR/>- area: double<BR/>- ubicacion: String<BR/>- tipoRiego: TipoRiego<BR/>- cultivos: List&lt;Cultivo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ agregarCultivo(c: Cultivo)<BR/>+ getAreaOcupada(): double<BR/>+ getAreaLibre(): double<BR/>+ contarCultivosActivos(): int</TD></TR></TABLE>>];
TipoCultivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><B>TipoCultivo</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- nombre: String<BR/>- diasCiclo: int<BR/>- rendimientoKgM2: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ getDiasCiclo(): int<BR/>+ getRendimientoKgM2(): double</TD></TR></TABLE>>];
Cultivo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#bbdefb" ALIGN="CENTER"><B>Cultivo</B><BR/><FONT POINT-SIZE="8">M2</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- id: String<BR/>- variedad: String<BR/>- fechaSiembra: LocalDate<BR/>- areaSembrada: double<BR/>- estado: EstadoCultivo<BR/>- causaPerdida: CausaPerdida<BR/>- fechaCambioEstado: LocalDate</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ calcularFechaEstimadaCosecha(): LocalDate<BR/>+ calcularKgEsperados(): double<BR/>+ alcanzoFechaEstimada(hoy): boolean<BR/>+ cambiarEstado(nuevo, causa, fecha)<BR/>+ getNombre(): String</TD></TR></TABLE>>];
Labor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#ffe0b2" ALIGN="CENTER"><B>Labor</B><BR/><FONT POINT-SIZE="8">M3</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- numero: int<BR/>- tipo: TipoLabor<BR/>- fechaProgramada: LocalDate<BR/>- estado: EstadoLabor<BR/>- fechaRealizacion: LocalDate<BR/>- horasTrabajadas: double<BR/>- observaciones: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ actualizarAtraso(hoy): boolean<BR/>+ registrarCumplimiento(fecha, horas, obs)<BR/>+ reprogramar(fecha, responsable, hoy)<BR/>+ cancelar()<BR/>+ estaAbierta(): boolean</TD></TR></TABLE>>];
Cosecha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e1bee7" ALIGN="CENTER"><B>Cosecha</B><BR/><FONT POINT-SIZE="8">M4</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- codigo: String<BR/>- fecha: LocalDate<BR/>- kg: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ calcularRendimiento(): double<BR/>+ calcularKgPorM2(): double<BR/>+ estaRepartida(): boolean</TD></TR></TABLE>>];
Reparto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e1bee7" ALIGN="CENTER"><B>Reparto</B><BR/><FONT POINT-SIZE="8">M4</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- porcentajeReserva: double<BR/>- kgReserva: double<BR/>- items: List&lt;ItemReparto&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ agregarItem(item: ItemReparto)<BR/>+ getKgRepartidos(): double<BR/>+ incluye(p: Participante): boolean</TD></TR></TABLE>>];
ItemReparto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#ffffff" COLOR="#555555"><TR><TD BGCOLOR="#e1bee7" ALIGN="CENTER"><B>ItemReparto</B><BR/><FONT POINT-SIZE="8">M4</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">- horas: double<BR/>- porcentaje: double<BR/>- kg: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" SIDES="T">+ getKg(): double</TD></TR></TABLE>>];
{rank=same; Persona; Huerto; TipoCultivo;}
{rank=same; Participante; Labor; Parcela;}
{rank=same; ItemReparto; Cosecha; Cultivo;}
Persona -> Huerto -> TipoCultivo [style=invis];
Participante -> Labor -> Parcela [style=invis];
ItemReparto -> Cosecha -> Cultivo [style=invis];
Participante -> Persona [arrowhead=empty];
Huerto -> Participante [dir=back, arrowtail=odiamond, taillabel="1", headlabel="0..*"];
Huerto -> Parcela [dir=back, arrowtail=odiamond, taillabel="1", headlabel="0..*"];
Huerto -> TipoCultivo [dir=back, arrowtail=odiamond, taillabel="1", headlabel="1..*", xlabel="catálogo"];
Huerto -> Labor [dir=back, arrowtail=odiamond, taillabel="1", headlabel="0..*"];
Huerto -> Cosecha [dir=back, arrowtail=odiamond, taillabel="1", headlabel="0..*"];
Parcela -> Cultivo [dir=back, arrowtail=diamond, taillabel="1", headlabel="0..*"];
Cultivo -> TipoCultivo [arrowhead=vee, taillabel="0..*", headlabel="1", xlabel="tipo", constraint=false];
Labor -> Cultivo [arrowhead=vee, taillabel="0..*", headlabel="1"];
Labor -> Participante [arrowhead=vee, taillabel="0..*", headlabel="1", xlabel="responsable", constraint=false];
Cosecha -> Cultivo [arrowhead=vee, taillabel="0..1", headlabel="1", constraint=false];
Cosecha -> Reparto [dir=back, arrowtail=diamond, taillabel="1", headlabel="0..1"];
ItemReparto -> Reparto [dir=forward, arrowhead=diamond, taillabel="1..*", headlabel="1"];
ItemReparto -> Participante [arrowhead=vee, taillabel="0..*", headlabel="1", constraint=false];
}